{
  "name": "anchor-budget-chatbot",
  "version": "0.1.0",
  "private": true,
  "description": "앵커 사업비 지침 안내 챗봇",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"tsx watch --clear-screen=false server/index.ts\" \"vite\"",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "reset-admin": "tsx server/scripts/reset-admin.ts",
    "test": "tsx --test server/**/*.test.ts",
    "download-model": "tsx server/scripts/download-model.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.6",
    "@fastify/static": "^10.1.8",
    "@huggingface/transformers": "^4.3.2",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.9",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.7",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "unpdf": "^1.9.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.6",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
