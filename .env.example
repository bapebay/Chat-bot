# ===== 앵커 사업비 챗봇 설정 =====
# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 저장소에 올라가지 않습니다)

# 서버 포트
PORT=3000

# 최초 관리자 계정 (DB에 관리자가 하나도 없을 때 한 번만 만들어집니다. 첫 로그인 시 비밀번호 변경 필수)
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=change-me-1234

# 로그인 유지 시간(시간 단위)
SESSION_HOURS=8

# HTTPS로 서비스할 때만 true (쿠키에 Secure 속성 부여 + 브라우저에 HTTPS만 쓰도록 알림)
COOKIE_SECURE=false

# ----- 외부 공개용 보안 -----
# 앞단 웹서버(Nginx 등)는 같은 서버나 내부망(사설 IP)에 두세요. 그러면 실제 접속자 IP를 자동으로 읽습니다.
# IP별 요청 횟수 제한 (로그인 1분 10회, 가입 1시간 5회, 질문 1분 15회 등). off 로만 끌 수 있음
RATE_LIMIT=on

# ----- AI 모델 -----
# LLM_PROVIDER: gemini | claude | openai | mock
#   mock = API 키 없이 화면 동작만 확인하는 가짜 응답
LLM_PROVIDER=mock

# Gemini 사용 시
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI 호환 방식 사용 시 (LLM_PROVIDER=openai)
#   OpenAI, 국내 클라우드 AI, 기관 내부에 설치한 모델(vLLM·Ollama 등) 모두 이 방식으로 연결
#   OPENAI_BASE_URL 예: https://api.openai.com/v1 , http://10.0.0.5:8000/v1
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
# json_object(대부분 지원) | json_schema(지원하는 곳만, 더 정확) | none(형식 지정 미지원 모델)
OPENAI_JSON_MODE=json_object

# Claude 사용 시 (가벼운 모델로 시작해 답변 품질을 보고 올립니다)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# 선택: low | medium | high (비워두면 모델 기본값)
CLAUDE_EFFORT=low

# 답변 최대 길이(토큰)
LLM_MAX_OUTPUT_TOKENS=4096
# 모델에 함께 보내는 최근 대화 메시지 수
LLM_HISTORY_MESSAGES=6

# DB 파일 위치
DATABASE_PATH=./data/chatbot.db

# 의미 검색 모델 폴더 (npm run download-model 로 내려받는 곳)
MODELS_DIR=./models

# ----- 백업 -----
# 백업 파일을 둘 폴더 (DB와 다른 디스크면 더 안전)
BACKUP_DIR=./backups
# 자동 백업 간격(시간). 0 이면 끔
BACKUP_INTERVAL_HOURS=24
# 남겨 둘 백업 개수
BACKUP_KEEP=14
