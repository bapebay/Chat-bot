# ===== 앵커 사업비 챗봇 설정 =====
# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 저장소에 올라가지 않습니다)

# 서버 포트
PORT=3000

# 최초 관리자 계정 (DB에 관리자가 하나도 없을 때 한 번만 만들어집니다. 첫 로그인 시 비밀번호 변경 필수)
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=change-me-1234

# 로그인 유지 시간(시간 단위)
SESSION_HOURS=8

# HTTPS로 서비스할 때만 true (쿠키에 Secure 속성 부여)
COOKIE_SECURE=false

# ----- AI 모델 -----
# LLM_PROVIDER: gemini | claude | mock
#   mock = API 키 없이 화면 동작만 확인하는 가짜 응답
LLM_PROVIDER=mock

# Gemini 사용 시
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Claude 사용 시 (가벼운 모델로 시작해 평가 점수를 보고 올립니다)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# 선택: low | medium | high (비워두면 모델 기본값)
CLAUDE_EFFORT=low

# 답변 최대 길이(토큰)
LLM_MAX_OUTPUT_TOKENS=4096
# 모델에 함께 보내는 최근 대화 메시지 수
LLM_HISTORY_MESSAGES=6

# DB 파일 위치
DATABASE_PATH=./data/chatbot.db

# 의미 검색 모델 폴더 (npm run download-model 로 내려받는 곳)
MODELS_DIR=./models
